generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductAvailability {
  AVAILABLE
  ORDER
}

enum LeadStatus {
  NEW
  REVIEWING
  CONTACTED
  COMPLETED
  IN_PROGRESS
  WON
  LOST
}

enum LeadSource {
  CONTACT_FORM
  MADINA
  PRODUCT
  PROJECT
  HOME_CTA
  OTHER
}

enum TelegramNotificationStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum LeadActivityType {
  LEAD_CREATED
  CLAIMED
  CONTACTED
  COMMENT_ADDED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_POSTPONED
  STATUS_CHANGED
  SALE_REPORTED
  SALE_CONFIRMED
  SALE_REJECTED
  REJECTED
}

enum SaleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MarjaTransactionType {
  SALE_EARNED
  REWARD_SPENT
  ADMIN_ADJUSTMENT
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum BackupStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadFollowUpStatus {
  SCHEDULED
  REMINDER_RESERVED
  REMINDER_SENT
  COMPLETED
  CANCELLED
}

enum LeadOutcome {
  THINKING
  LATER
  OFFER_SENT
  NEGOTIATING
  NO_ANSWER
  SALE
  REJECTED
  INVALID
}

enum TelegramConversationStep {
  AWAITING_COMMENT
  AWAITING_FOLLOW_UP
  AWAITING_CUSTOM_DATE
  AWAITING_POSTPONE
  AWAITING_POSTPONE_DATE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
}

enum Product360Status {
  DRAFT
  PROCESSING
  READY
  FAILED
}

model Product {
  id               String              @id @default(cuid())
  name             String
  brand            String
  model            String
  slug             String              @unique
  categoryId       String
  category         ProductCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceUsd         Decimal?            @db.Decimal(18, 2)
  shortDescription String?
  description      String?
  images           String[]            @default([])
  specifications   Json                @default("[]")
  tags             String[]            @default([])
  availability     ProductAvailability @default(AVAILABLE)
  isVisible        Boolean             @default(true)
  order            Int                 @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  asset360         Product360Asset?

  @@index([isVisible, order])
  @@index([categoryId])
}

model SiteSettings {
  id               String    @id @default("global")
  usdToUzs         Decimal   @default(12200) @db.Decimal(18, 4)
  currencySource   String?
  cbuNominal       Int?
  cbuEffectiveDate DateTime?
  cbuLastSyncedAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive, order])
}

model Product360Asset {
  id           String           @id @default(cuid())
  productId    String           @unique
  status       Product360Status @default(DRAFT)
  sourceImages Json             @default("{}")
  frames       String[]         @default([])
  frameCount   Int              @default(0)
  posterImage  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Project {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  shortDescription String?
  description      String?
  location         String?
  temperature      String?
  capacity         String?
  category         String?
  images           String[] @default([])
  coverImage       String?
  isVisible        Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isVisible, isFeatured, order])
}

model HomeContent {
  id               String   @id @default(cuid())
  hero             Json
  selector         Json
  solutions        Json
  featuredProducts Json
  temperatureRange Json
  projects         Json
  reasons          Json
  cta              Json
  footer           Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Lead {
  id                              String                      @id @default(cuid())
  submissionKey                   String?                     @unique
  customerName                    String?
  phone                           String?
  telegram                        String?
  requestType                     String
  product                         String?
  dimensions                      String?
  capacity                        String?
  temperature                     String?
  region                          String?
  notes                           String?
  source                          LeadSource                  @default(OTHER)
  status                          LeadStatus                  @default(NEW)
  aiSummary                       String?
  chatHistory                     Json                        @default("[]")
  managerNote                     String?
  assignedAgentId                 String?
  claimedAt                       DateTime?
  telegramChatId                  String?
  telegramMessageId               Int?
  telegramPublishedAt             DateTime?
  telegramNotificationStatus      TelegramNotificationStatus  @default(PENDING)
  telegramPublishFailedAt         DateTime?
  telegramPrivateDeliveryFailedAt DateTime?
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt
  assignedAgent                   SalesAgent?                 @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  activities                      LeadActivity[]
  followUps                       LeadFollowUp[]
  telegramConversations           TelegramConversationState[]
  sale                            Sale?

  @@index([status, createdAt])
  @@index([assignedAgentId, claimedAt])
  @@index([telegramNotificationStatus])
}

model SalesAgent {
  id                   String                     @id @default(cuid())
  telegramUserId       BigInt                     @unique
  telegramUsername     String?
  firstName            String
  lastName             String?
  isActive             Boolean                    @default(true)
  isApproved           Boolean                    @default(false)
  joinedAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  assignedLeads        Lead[]
  activities           LeadActivity[]
  followUps            LeadFollowUp[]
  telegramConversation TelegramConversationState?
  sales                Sale[]
  marjaTransactions    MarjaTransaction[]
  rewardRedemptions    RewardRedemption[]

  @@index([isApproved, isActive])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  agentId   String?
  type      LeadActivityType
  comment   String?
  metadata  Json?
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent     SalesAgent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([agentId, createdAt])
}

model LeadFollowUp {
  id             String                      @id @default(cuid())
  leadId         String
  agentId        String
  scheduledFor   DateTime
  status         LeadFollowUpStatus          @default(SCHEDULED)
  reminderSentAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  lead           Lead                        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent          SalesAgent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversations  TelegramConversationState[]

  @@index([status, scheduledFor])
  @@index([leadId, status])
  @@index([agentId, scheduledFor])
}

model TelegramConversationState {
  agentId    String                   @id
  leadId     String
  step       TelegramConversationStep
  outcome    LeadOutcome?
  followUpId String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  agent      SalesAgent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead       Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  followUp   LeadFollowUp?            @relation(fields: [followUpId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

model TelegramUpdate {
  updateId  BigInt   @id
  createdAt DateTime @default(now())
}

model AdminUser {
  id                  String             @id @default(cuid())
  name                String
  phone               String             @unique
  passwordHash        String
  role                AdminRole          @default(MANAGER)
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  sessions            AdminSession[]
  approvedSales       Sale[]             @relation("SaleApprover")
  marjaAdjustments    MarjaTransaction[]
  reviewedRedemptions RewardRedemption[]
  backups             BackupRun[]
}

model Sale {
  id                 String            @id @default(cuid())
  leadId             String            @unique
  agentId            String
  status             SaleStatus        @default(PENDING)
  customerName       String?
  productDescription String
  saleAmount         Decimal?          @db.Decimal(18, 2)
  currency           String?           @db.VarChar(8)
  comment            String?
  reportedAt         DateTime          @default(now())
  approvedAt         DateTime?
  approvedByAdminId  String?
  rejectedAt         DateTime?
  rejectionReason    String?
  celebrationSentAt  DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lead               Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent              SalesAgent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  approvedByAdmin    AdminUser?        @relation("SaleApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  marjaTransaction   MarjaTransaction?

  @@index([status, reportedAt])
  @@index([agentId, status])
}

model MarjaTransaction {
  id                 String               @id @default(cuid())
  agentId            String
  saleId             String?              @unique
  rewardRedemptionId String?              @unique
  adminUserId        String?
  type               MarjaTransactionType
  amount             Int
  description        String
  createdAt          DateTime             @default(now())
  agent              SalesAgent           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  sale               Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  rewardRedemption   RewardRedemption?    @relation(fields: [rewardRedemptionId], references: [id], onDelete: Restrict)
  adminUser          AdminUser?           @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
  @@index([type, createdAt])
}

model Reward {
  id            String             @id @default(cuid())
  name          String
  requiredMarja Int
  description   String?
  isActive      Boolean            @default(true)
  order         Int                @default(0)
  seedKey       String?            @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  redemptions   RewardRedemption[]

  @@index([isActive, order])
}

model RewardRedemption {
  id                String                 @id @default(cuid())
  agentId           String
  rewardId          String
  status            RewardRedemptionStatus @default(PENDING)
  requiredMarja     Int
  requestedAt       DateTime               @default(now())
  reviewedAt        DateTime?
  reviewedByAdminId String?
  rejectionReason   String?
  fulfilledAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  agent             SalesAgent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  reward            Reward                 @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  reviewedByAdmin   AdminUser?             @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  marjaTransaction  MarjaTransaction?

  @@index([status, requestedAt])
  @@index([agentId, status])
}

model BackupRun {
  id               String       @id @default(cuid())
  status           BackupStatus @default(PROCESSING)
  storageKey       String?
  sizeBytes        Int?
  errorType        String?
  createdByAdminId String?
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  createdByAdmin   AdminUser?   @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([startedAt])
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  key         String   @id @db.VarChar(64)
  attempts    Int      @default(0)
  windowStart DateTime @default(now())
}
