generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductAvailability {
  AVAILABLE
  ORDER
}

enum LeadStatus {
  NEW
  REVIEWING
  CONTACTED
  COMPLETED
  IN_PROGRESS
  WON
  LOST
}

enum LeadSource {
  CONTACT_FORM
  MADINA
  PRODUCT
  PROJECT
  HOME_CTA
  OTHER
}

enum TelegramNotificationStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum LeadActivityType {
  LEAD_CREATED
  CLAIMED
  CONTACTED
  COMMENT_ADDED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_POSTPONED
  STATUS_CHANGED
  SALE_REPORTED
  REJECTED
}

enum LeadFollowUpStatus {
  SCHEDULED
  REMINDER_RESERVED
  REMINDER_SENT
  COMPLETED
  CANCELLED
}

enum LeadOutcome {
  THINKING
  LATER
  OFFER_SENT
  NEGOTIATING
  NO_ANSWER
  SALE
  REJECTED
  INVALID
}

enum TelegramConversationStep {
  AWAITING_COMMENT
  AWAITING_FOLLOW_UP
  AWAITING_CUSTOM_DATE
  AWAITING_POSTPONE
  AWAITING_POSTPONE_DATE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
}

enum Product360Status {
  DRAFT
  PROCESSING
  READY
  FAILED
}

model Product {
  id               String              @id @default(cuid())
  name             String
  brand            String
  model            String
  slug             String              @unique
  category         String
  shortDescription String?
  description      String?
  images           String[]            @default([])
  specifications   Json                @default("[]")
  tags             String[]            @default([])
  availability     ProductAvailability @default(AVAILABLE)
  isVisible        Boolean             @default(true)
  order            Int                 @default(0)
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  asset360         Product360Asset?

  @@index([isVisible, order])
  @@index([category])
}

model Product360Asset {
  id           String           @id @default(cuid())
  productId    String           @unique
  status       Product360Status @default(DRAFT)
  sourceImages Json             @default("{}")
  frames       String[]         @default([])
  frameCount   Int              @default(0)
  posterImage  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Project {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  shortDescription String?
  description      String?
  location         String?
  temperature      String?
  capacity         String?
  category         String?
  images           String[] @default([])
  coverImage       String?
  isVisible        Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isVisible, isFeatured, order])
}

model HomeContent {
  id               String   @id @default(cuid())
  hero             Json
  selector         Json
  solutions        Json
  featuredProducts Json
  temperatureRange Json
  projects         Json
  reasons          Json
  cta              Json
  footer           Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Lead {
  id           String     @id @default(cuid())
  customerName String?
  phone        String?
  telegram     String?
  requestType  String
  product      String?
  dimensions   String?
  capacity     String?
  temperature  String?
  region       String?
  notes        String?
  source       LeadSource @default(OTHER)
  status       LeadStatus @default(NEW)
  aiSummary    String?
  chatHistory  Json       @default("[]")
  managerNote  String?
  assignedAgentId String?
  claimedAt DateTime?
  telegramChatId String?
  telegramMessageId Int?
  telegramPublishedAt DateTime?
  telegramNotificationStatus TelegramNotificationStatus @default(PENDING)
  telegramPublishFailedAt DateTime?
  telegramPrivateDeliveryFailedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedAgent SalesAgent? @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  activities LeadActivity[]
  followUps LeadFollowUp[]
  telegramConversations TelegramConversationState[]

  @@index([status, createdAt])
  @@index([assignedAgentId, claimedAt])
  @@index([telegramNotificationStatus])
}

model SalesAgent {
  id String @id @default(cuid())
  telegramUserId BigInt @unique
  telegramUsername String?
  firstName String
  lastName String?
  isActive Boolean @default(true)
  isApproved Boolean @default(false)
  joinedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignedLeads Lead[]
  activities LeadActivity[]
  followUps LeadFollowUp[]
  telegramConversation TelegramConversationState?

  @@index([isApproved, isActive])
}

model LeadActivity {
  id String @id @default(cuid())
  leadId String
  agentId String?
  type LeadActivityType
  comment String?
  metadata Json?
  createdAt DateTime @default(now())
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent SalesAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([agentId, createdAt])
}

model LeadFollowUp {
  id String @id @default(cuid())
  leadId String
  agentId String
  scheduledFor DateTime
  status LeadFollowUpStatus @default(SCHEDULED)
  reminderSentAt DateTime?
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent SalesAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversations TelegramConversationState[]

  @@index([status, scheduledFor])
  @@index([leadId, status])
  @@index([agentId, scheduledFor])
}

model TelegramConversationState {
  agentId String @id
  leadId String
  step TelegramConversationStep
  outcome LeadOutcome?
  followUpId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agent SalesAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  followUp LeadFollowUp? @relation(fields: [followUpId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

model TelegramUpdate {
  updateId BigInt @id
  createdAt DateTime @default(now())
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  passwordHash String
  role         AdminRole @default(MANAGER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     AdminSession[]
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  key         String   @id @db.VarChar(64)
  attempts    Int      @default(0)
  windowStart DateTime @default(now())
}
