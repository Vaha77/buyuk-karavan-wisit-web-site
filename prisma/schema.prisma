generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProductAvailability {
  AVAILABLE
  ORDER
}

enum LeadStatus {
  NEW
  REVIEWING
  CONTACTED
  COMPLETED
  IN_PROGRESS
  WON
  LOST
}

enum LeadSource {
  CONTACT_FORM
  MADINA
  PRODUCT
  PRODUCT_CONSULTATION
  PROJECT
  HOME_CTA
  OTHER
  INSTAGRAM
  // A phone number written in an Instagram Direct message.
  INSTAGRAM_DM
}

enum TelegramNotificationStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum LeadActivityType {
  LEAD_CREATED
  CLAIMED
  CONTACTED
  COMMENT_ADDED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  FOLLOW_UP_POSTPONED
  STATUS_CHANGED
  SALE_REPORTED
  SALE_CONFIRMED
  SALE_REJECTED
  REJECTED
}

enum SaleStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MarjaTransactionType {
  SALE_EARNED
  REWARD_SPENT
  ADMIN_ADJUSTMENT
}

enum RewardRedemptionStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

enum BackupStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum LeadFollowUpStatus {
  SCHEDULED
  REMINDER_RESERVED
  REMINDER_SENT
  COMPLETED
  CANCELLED
}

enum LeadOutcome {
  THINKING
  LATER
  OFFER_SENT
  NEGOTIATING
  NO_ANSWER
  SALE
  REJECTED
  INVALID
}

enum TelegramConversationStep {
  AWAITING_COMMENT
  AWAITING_FOLLOW_UP
  AWAITING_CUSTOM_DATE
  AWAITING_POSTPONE
  AWAITING_POSTPONE_DATE
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  SELLER
  // Sex mas'uli: only /admin/sex (accepts and issues workshop orders).
  WORKSHOP
}

enum AdminApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Product360Status {
  DRAFT
  PROCESSING
  READY
  FAILED
}

enum CalculationStatus {
  DRAFT
  READY
  SENT
  NEGOTIATION
  APPROVED
  REJECTED
}

enum CalculationConfigurationType {
  RECOMMENDED
  MARKET_1
  MARKET_2
}

enum CalculationCurrency {
  USD
  UZS
}

enum CalculationRoomType {
  ROOM
  CORRIDOR
}

enum CalculationDoorSide {
  TOP
  BOTTOM
  LEFT
  RIGHT
}

model Product {
  id                   String                @id @default(cuid())
  name                 String
  brand                String
  model                String
  slug                 String                @unique
  categoryId           String
  category             ProductCategory       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  priceUsd             Decimal?              @db.Decimal(18, 2)
  shortDescription     String?
  description          String?
  images               String[]              @default([])
  specifications       Json                  @default("[]")
  tags                 String[]              @default([])
  availability         ProductAvailability   @default(AVAILABLE)
  isVisible            Boolean               @default(true)
  order                Int                   @default(0)
  seoTitle             String?
  seoDescription       String?
  // Prays: purchase/list price (USD); priceUsd is the selling price = ceil(basePriceUsd × (100 + markup) / 100).
  basePriceUsd         Decimal?              @db.Decimal(18, 2)
  priceListDate        DateTime?
  // Removed from Prays: hidden from the site and price lists, the row itself is kept.
  archivedAt           DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  asset360             Product360Asset?
  calculationLineItems CalculationLineItem[]
  workshopItems        WorkshopOrderItem[]
  instagramRules       InstagramMediaRule[]  @relation("InstagramRuleProduct")
  instagramSecondRules InstagramMediaRule[]  @relation("InstagramRuleSecondProduct")

  @@index([isVisible, order])
  @@index([isVisible, categoryId])
  @@index([categoryId])
}

model SiteSettings {
  id               String    @id @default("global")
  usdToUzs         Decimal   @default(12200) @db.Decimal(18, 4)
  currencySource   String?
  cbuNominal       Int?
  cbuEffectiveDate DateTime?
  cbuLastSyncedAt  DateTime?
  dashboardTips    Json?
  // Sotuv rejasi zone thresholds (percent lower bounds); null = defaults in lib/sales-plan/zones.ts.
  salesPlanZones   Json?
  // Prays: selling markup over basePriceUsd, 1–20 %.
  priceMarkupPercent Int     @default(10)
  // Seh: how many orders the workshop should start per day (a warning, not a block).
  workshopDailyLimit Int     @default(5)
  // Zborka: the condenser category whose price is the "standart" one (price difference = chosen − standard).
  standardCondenserCategoryId String? @db.VarChar(40)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  isActive  Boolean   @default(true)
  order     Int       @default(0)
  // Seh (Prays → Kategoriyalar, Super Admin only; apply to every product of the category, present and future):
  // "Zborkada ishlatiladi" with its role in the zborka form, and "Sehdan alohida chiqadi" (zapchast zayavkasi).
  workshopAssembly Boolean @default(false)
  // "COMPRESSOR" | "CONDENSER" (only with workshopAssembly)
  workshopRole     String? @db.VarChar(20)
  workshopIssue    Boolean @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([isActive, order])
}

model Product360Asset {
  id           String           @id @default(cuid())
  productId    String           @unique
  status       Product360Status @default(DRAFT)
  sourceImages Json             @default("{}")
  frames       String[]         @default([])
  frameCount   Int              @default(0)
  posterImage  String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  product      Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Project {
  id               String   @id @default(cuid())
  title            String
  slug             String   @unique
  shortDescription String?
  description      String?
  location         String?
  temperature      String?
  capacity         String?
  category         String?
  images           String[] @default([])
  coverImage       String?
  isVisible        Boolean  @default(true)
  isFeatured       Boolean  @default(false)
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isVisible, isFeatured, order])
}

model HomeContent {
  id               String   @id @default(cuid())
  hero             Json
  selector         Json
  solutions        Json
  featuredProducts Json
  temperatureRange Json
  projects         Json
  reasons          Json
  cta              Json
  footer           Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Lead {
  id                              String                      @id @default(cuid())
  submissionKey                   String?                     @unique
  customerName                    String?
  phone                           String?
  telegram                        String?
  requestType                     String
  product                         String?
  productId                       String?
  productSlug                     String?
  dimensions                      String?
  capacity                        String?
  temperature                     String?
  region                          String?
  country                         String?                     @db.VarChar(8)
  regionCode                      String?                     @db.VarChar(16)
  referralLinkId                  String?
  visitId                         String?                     @unique
  notes                           String?
  source                          LeadSource                  @default(OTHER)
  // INSTAGRAM / INSTAGRAM_DM: which account (InstagramAccount.id) — "Instagram · @eshikmaster".
  instagramAccountId              String?                     @db.VarChar(64)
  status                          LeadStatus                  @default(NEW)
  aiSummary                       String?
  chatHistory                     Json                        @default("[]")
  managerNote                     String?
  assignedAgentId                 String?
  claimedAt                       DateTime?
  telegramChatId                  String?
  telegramMessageId               Int?
  telegramPublishedAt             DateTime?
  telegramNotificationStatus      TelegramNotificationStatus  @default(PENDING)
  telegramPublishFailedAt         DateTime?
  telegramPrivateDeliveryFailedAt DateTime?
  createdAt                       DateTime                    @default(now())
  updatedAt                       DateTime                    @updatedAt
  assignedAgent                   SalesAgent?                 @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  activities                      LeadActivity[]
  followUps                       LeadFollowUp[]
  telegramConversations           TelegramConversationState[]
  sale                            Sale?
  referralLink                    ReferralLink?               @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)
  visit                           Visit?                      @relation(fields: [visitId], references: [id], onDelete: SetNull)
  calculations                    Calculation[]

  @@index([status, createdAt])
  @@index([createdAt])
  @@index([country, regionCode])
  @@index([referralLinkId, createdAt])
  @@index([productId])
  @@index([assignedAgentId, claimedAt])
  @@index([telegramNotificationStatus])
}

model SalesAgent {
  id                   String                     @id @default(cuid())
  telegramUserId       BigInt                     @unique
  telegramUsername     String?
  firstName            String
  lastName             String?
  isActive             Boolean                    @default(true)
  isApproved           Boolean                    @default(false)
  joinedAt             DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  assignedLeads        Lead[]
  activities           LeadActivity[]
  followUps            LeadFollowUp[]
  telegramConversation TelegramConversationState?
  sales                Sale[]
  marjaTransactions    MarjaTransaction[]
  rewardRedemptions    RewardRedemption[]
  referralLinks        ReferralLink[]
  salesPerson          SalesPerson?

  @@index([isApproved, isActive])
}

model LeadActivity {
  id        String           @id @default(cuid())
  leadId    String
  agentId   String?
  type      LeadActivityType
  comment   String?
  metadata  Json?
  createdAt DateTime         @default(now())
  lead      Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent     SalesAgent?      @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([agentId, createdAt])
}

model LeadFollowUp {
  id             String                      @id @default(cuid())
  leadId         String
  agentId        String
  scheduledFor   DateTime
  status         LeadFollowUpStatus          @default(SCHEDULED)
  reminderSentAt DateTime?
  completedAt    DateTime?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  lead           Lead                        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent          SalesAgent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversations  TelegramConversationState[]

  @@index([status, scheduledFor])
  @@index([leadId, status])
  @@index([agentId, scheduledFor])
}

model TelegramConversationState {
  agentId    String                   @id
  leadId     String
  step       TelegramConversationStep
  outcome    LeadOutcome?
  followUpId String?
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
  agent      SalesAgent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead       Lead                     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  followUp   LeadFollowUp?            @relation(fields: [followUpId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

model TelegramUpdate {
  updateId  BigInt   @id
  createdAt DateTime @default(now())
}

model AdminUser {
  id                   String                       @id @default(cuid())
  name                 String
  phone                String                       @unique
  passwordHash         String
  role                 AdminRole                    @default(MANAGER)
  isActive             Boolean                      @default(true)
  approvalStatus       AdminApprovalStatus          @default(APPROVED)
  // Set when the Super Admin resets the password: the next login goes straight to "Yangi parol o‘rnating".
  mustPasswordChange   Boolean                      @default(false)
  // Super Admin's 👁 on the users page: AES-256-GCM (key PASSWORD_VIEW_KEY, env only). Login still uses passwordHash.
  passwordEncrypted    String?
  // "O‘chirish" of a user with linked records: archived (cannot log in, hidden, restorable) instead of deleted.
  archivedAt           DateTime?
  // Telegram user id (= private chat id); WORKSHOP users press the workshop group buttons with it.
  telegramChatId       String?                      @unique @db.VarChar(32)
  // One-time "Telegram ulash" code (deep link t.me/<bot>?start=seh_<code>), valid 15 minutes.
  telegramLinkCode      String?                     @unique @db.VarChar(40)
  telegramLinkExpiresAt DateTime?
  // Gets Instagram Direct cards, reminders and the daily report in Telegram (needs telegramChatId).
  receivesInstagramDirect Boolean                   @default(false)
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt
  sessions             AdminSession[]
  approvedSales        Sale[]                       @relation("SaleApprover")
  marjaAdjustments     MarjaTransaction[]
  reviewedRedemptions  RewardRedemption[]
  backups              BackupRun[]
  auditLogs            AuditLog[]                   @relation("AuditActor")
  createdPhotoAssets   PhotoStudioAsset[]           @relation("PhotoAssetCreator")
  attachedPhotoAssets  PhotoStudioAsset[]           @relation("PhotoAssetAttacher")
  calculations         Calculation[]
  aiPriceLists         AiPriceList[]
  referralLinks        ReferralLink[]
  customerSalesCreated RegularCustomerMonthlySale[] @relation("CustomerSaleCreator")
  customerSalesUpdated RegularCustomerMonthlySale[] @relation("CustomerSaleUpdater")
  salesPersonId        String?                      @unique
  salesPerson          SalesPerson?                 @relation(fields: [salesPersonId], references: [id], onDelete: SetNull)
  purchasesCreated     CustomerPurchase[]           @relation("PurchaseCreator")
  purchasesReviewed    CustomerPurchase[]           @relation("PurchaseReviewer")
  priceChanges         PriceChange[]
  workshopOrdersSold     WorkshopOrder[]            @relation("WorkshopOrderSeller")
  commercialOffers       CommercialOffer[]
  workshopOrdersCreated  WorkshopOrder[]            @relation("WorkshopOrderCreator")
  workshopOrdersAccepted WorkshopOrder[]            @relation("WorkshopOrderAcceptor")
  workshopOrdersStarted  WorkshopOrder[]            @relation("WorkshopOrderStarter")
  workshopOrdersIssued   WorkshopOrder[]            @relation("WorkshopOrderIssuer")
  workshopOrdersReceived WorkshopOrder[]            @relation("WorkshopOrderReceiver")
  workshopOrdersCancelled WorkshopOrder[]           @relation("WorkshopOrderCanceller")
  workshopCorrectionsAsked    WorkshopCorrectionRequest[] @relation("WorkshopCorrectionRequester")
  workshopCorrectionsResolved WorkshopCorrectionRequest[] @relation("WorkshopCorrectionResolver")

  @@index([approvalStatus, isActive])
}

model AiPriceList {
  id               String    @id @default(cuid())
  filename         String
  sourceHash       String
  sheetName        String
  blockKey         String
  blockLabel       String
  parsed           Json
  isActive         Boolean   @default(true)
  createdByAdminId String
  createdAt        DateTime  @default(now())
  createdBy        AdminUser @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)

  @@index([isActive, createdAt])
  @@index([createdByAdminId, createdAt])
}

model Calculation {
  id                    String                     @id @default(cuid())
  customerName          String
  phone                 String?
  region                String?
  projectName           String
  capacityTons          Decimal?                   @db.Decimal(10, 2)
  cameraCount           Int                        @default(0)
  temperatureMin        Decimal?                   @db.Decimal(6, 2)
  temperatureMax        Decimal?                   @db.Decimal(6, 2)
  notes                 String?
  buildingWidth         Decimal                    @db.Decimal(10, 2)
  buildingLength        Decimal                    @db.Decimal(10, 2)
  buildingHeight        Decimal                    @db.Decimal(10, 2)
  status                CalculationStatus          @default(DRAFT)
  electricityTariff     Decimal?                   @db.Decimal(18, 2)
  specialistConclusion  String?
  proposalNumber        String?                    @unique
  proposalDate          DateTime?
  validityDays          Int?
  paymentTerms          String?
  deliveryTerms         String?
  installationIncluded  Boolean?
  transportIncluded     Boolean?
  commissioningIncluded Boolean?
  warranty              String?
  commercialNotes       String?
  renderImageUrl        String?
  manualUzsTotalWithVat Decimal?                   @db.Decimal(18, 2)
  proposalNote          String?
  discountPercent       Decimal?                   @db.Decimal(8, 4)
  // Komplekt konfiguratori: who the offer is for, and the chosen parts with price-list prices (SUPER_ADMIN only).
  customerId            String?
  leadId                String?
  configurator          Json?
  createdByAdminId      String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  createdBy             AdminUser                  @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  customer              RegularCustomer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead                  Lead?                      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  rooms                 CalculationRoom[]
  configurations        CalculationConfiguration[]
  lineItems             CalculationLineItem[]

  @@index([status, updatedAt])
  @@index([createdByAdminId, updatedAt])
  @@index([customerId])
  @@index([leadId])
}

model CalculationConfiguration {
  id                      String                       @id
  calculationId           String
  type                    CalculationConfigurationType
  label                   String
  compressor              String?
  compressorNote          String?
  condenser               String?
  condenserNote           String?
  evaporator              String?
  evaporatorNote          String?
  refrigerant             String?
  electricalPanel         String?
  trv                     String?
  copperPipe              String?
  fittings                String?
  freon                   String?
  installationAccessories String?
  includedEquipment       String?
  priceUsd                Decimal?                     @db.Decimal(18, 2)
  powerKw                 Decimal?                     @db.Decimal(12, 3)
  operatingHoursPerDay    Decimal?                     @db.Decimal(8, 2)
  order                   Int
  calculation             Calculation                  @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@unique([calculationId, type])
  @@unique([calculationId, order])
  @@index([calculationId])
}

model CalculationLineItem {
  id            String              @id
  calculationId String
  productId     String?
  name          String
  unit          String
  quantity      Decimal             @db.Decimal(18, 3)
  unitPrice     Decimal             @db.Decimal(18, 2)
  currency      CalculationCurrency
  order         Int
  calculation   Calculation         @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  product       Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([calculationId, order])
  @@index([calculationId])
  @@index([productId])
}

model CalculationRoom {
  id             String               @id
  calculationId  String
  name           String
  type           CalculationRoomType
  x              Decimal              @db.Decimal(10, 2)
  y              Decimal              @db.Decimal(10, 2)
  width          Decimal              @db.Decimal(10, 2)
  length         Decimal              @db.Decimal(10, 2)
  height         Decimal?             @db.Decimal(10, 2)
  capacityTons   Decimal?             @db.Decimal(10, 2)
  temperatureMin Decimal?             @db.Decimal(6, 2)
  temperatureMax Decimal?             @db.Decimal(6, 2)
  doorEnabled    Boolean              @default(false)
  doorSide       CalculationDoorSide?
  equipmentModel String?
  order          Int
  calculation    Calculation          @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@unique([calculationId, order])
  @@index([calculationId])
}

model AuditLog {
  id                String    @id @default(cuid())
  actorAdminId      String
  actorNameSnapshot String
  action            String
  entityType        String
  entityId          String
  entityName        String?
  summary           String
  before            Json?
  after             Json?
  metadata          Json?
  createdAt         DateTime  @default(now())
  actor             AdminUser @relation("AuditActor", fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@index([actorAdminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model PhotoStudioAsset {
  id                String     @id @default(cuid())
  mode              String
  creatorAdminId    String
  attachedProductId String?
  attachedByAdminId String?
  attachedAt        DateTime?
  createdAt         DateTime   @default(now())
  creator           AdminUser  @relation("PhotoAssetCreator", fields: [creatorAdminId], references: [id], onDelete: Restrict)
  attachedBy        AdminUser? @relation("PhotoAssetAttacher", fields: [attachedByAdminId], references: [id], onDelete: Restrict)

  @@index([creatorAdminId])
  @@index([attachedProductId])
  @@index([createdAt])
}

model Sale {
  id                 String            @id @default(cuid())
  leadId             String            @unique
  agentId            String
  status             SaleStatus        @default(PENDING)
  customerName       String?
  productDescription String
  saleAmount         Decimal?          @db.Decimal(18, 2)
  currency           String?           @db.VarChar(8)
  comment            String?
  reportedAt         DateTime          @default(now())
  approvedAt         DateTime?
  approvedByAdminId  String?
  rejectedAt         DateTime?
  rejectionReason    String?
  celebrationSentAt  DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  lead               Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent              SalesAgent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  approvedByAdmin    AdminUser?        @relation("SaleApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  marjaTransaction   MarjaTransaction?

  @@index([status, reportedAt])
  @@index([agentId, status])
}

model MarjaTransaction {
  id                 String               @id @default(cuid())
  agentId            String
  saleId             String?              @unique
  rewardRedemptionId String?              @unique
  adminUserId        String?
  type               MarjaTransactionType
  amount             Int
  description        String
  createdAt          DateTime             @default(now())
  agent              SalesAgent           @relation(fields: [agentId], references: [id], onDelete: Restrict)
  sale               Sale?                @relation(fields: [saleId], references: [id], onDelete: Restrict)
  rewardRedemption   RewardRedemption?    @relation(fields: [rewardRedemptionId], references: [id], onDelete: Restrict)
  adminUser          AdminUser?           @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([agentId, createdAt])
  @@index([type, createdAt])
}

model Reward {
  id            String             @id @default(cuid())
  name          String
  requiredMarja Int
  description   String?
  isActive      Boolean            @default(true)
  order         Int                @default(0)
  seedKey       String?            @unique
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  redemptions   RewardRedemption[]

  @@index([isActive, order])
}

model RewardRedemption {
  id                String                 @id @default(cuid())
  agentId           String
  rewardId          String
  status            RewardRedemptionStatus @default(PENDING)
  requiredMarja     Int
  requestedAt       DateTime               @default(now())
  reviewedAt        DateTime?
  reviewedByAdminId String?
  rejectionReason   String?
  fulfilledAt       DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  agent             SalesAgent             @relation(fields: [agentId], references: [id], onDelete: Restrict)
  reward            Reward                 @relation(fields: [rewardId], references: [id], onDelete: Restrict)
  reviewedByAdmin   AdminUser?             @relation(fields: [reviewedByAdminId], references: [id], onDelete: SetNull)
  marjaTransaction  MarjaTransaction?

  @@index([status, requestedAt])
  @@index([agentId, status])
}

model BackupRun {
  id               String       @id @default(cuid())
  status           BackupStatus @default(PROCESSING)
  storageKey       String?
  sizeBytes        Int?
  errorType        String?
  createdByAdminId String?
  startedAt        DateTime     @default(now())
  completedAt      DateTime?
  createdByAdmin   AdminUser?   @relation(fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([startedAt])
}

model AdminSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AdminLoginAttempt {
  key         String   @id @db.VarChar(64)
  attempts    Int      @default(0)
  windowStart DateTime @default(now())
}

enum ReferralSource {
  YOUTUBE
  INSTAGRAM
  TELEGRAM
  TIKTOK
  GOOGLE_ADS
  BLOGGER
  QR
  OTHER
}

enum ReferralLinkStatus {
  ACTIVE
  PAUSED
}

enum VisitDevice {
  MOBILE
  DESKTOP
  TABLET
}

enum VisitOutcome {
  LEFT
  INTERESTED
  CONTACT_ATTEMPT
  LEAD
  SALE
}

enum VisitEventType {
  PAGEVIEW
  PRODUCT_VIEW
  TEL_CLICK
  TELEGRAM_CLICK
  MADINA_OPEN
  FORM_SUBMIT
  HEARTBEAT
}

enum MoneyCurrency {
  USD
  UZS
}

model ReferralLink {
  id               String             @id @default(cuid())
  name             String
  source           ReferralSource
  slug             String             @unique @db.VarChar(40)
  targetPath       String
  cost             Decimal?           @db.Decimal(18, 2)
  costCurrency     MoneyCurrency?
  ownerAgentId     String?
  status           ReferralLinkStatus @default(ACTIVE)
  createdByAdminId String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  ownerAgent       SalesAgent?        @relation(fields: [ownerAgentId], references: [id], onDelete: SetNull)
  createdBy        AdminUser          @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  visits           Visit[]
  leads            Lead[]

  @@index([status, createdAt])
  @@index([source])
}

model Visit {
  id             String        @id @default(cuid())
  referralLinkId String?
  visitorId      String        @db.VarChar(40)
  firstSeenAt    DateTime      @default(now())
  lastSeenAt     DateTime      @default(now())
  country        String?       @db.VarChar(8)
  regionCode     String?       @db.VarChar(16)
  device         VisitDevice   @default(DESKTOP)
  pageCount      Int           @default(0)
  durationSec    Int           @default(0)
  outcome        VisitOutcome  @default(LEFT)
  referralLink   ReferralLink? @relation(fields: [referralLinkId], references: [id], onDelete: SetNull)
  events         VisitEvent[]
  lead           Lead?

  @@index([referralLinkId, firstSeenAt])
  @@index([referralLinkId, outcome])
  @@index([visitorId, lastSeenAt])
  @@index([firstSeenAt])
}

model VisitEvent {
  id        String         @id @default(cuid())
  visitId   String
  type      VisitEventType
  path      String         @db.VarChar(300)
  createdAt DateTime       @default(now())
  visit     Visit          @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
}

model RegularCustomer {
  id               String                       @id @default(cuid())
  name             String
  country          String                       @default("UZ") @db.VarChar(8)
  regionCode       String?                      @db.VarChar(16)
  phone            String?
  note             String?
  isActive         Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  // Seller that owns the customer; null = unassigned, visible to admins only.
  ownerId          String?
  callIntervalDays Int                          @default(60)
  lastPurchaseAt   DateTime?
  nextContactAt    DateTime?
  phoneNormalized  String?                      @unique @db.VarChar(16)
  owner            SalesPerson?                 @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  sales            RegularCustomerMonthlySale[]
  contacts         CustomerContact[]
  purchases        CustomerPurchase[]
  workshopOrders   WorkshopOrder[]
  calculations     Calculation[]
  commercialOffers CommercialOffer[]

  @@index([isActive])
  @@index([ownerId, isActive])
}

enum CustomerContactResult {
  CALLED
  NO_ANSWER
  LATER
  AWAITING_PURCHASE
}

enum CustomerPurchaseStatus {
  PENDING
  APPROVED
  REJECTED
}

model CustomerContact {
  id            String                @id @default(cuid())
  customerId    String
  sellerId      String?
  at            DateTime              @default(now())
  result        CustomerContactResult
  note          String?
  nextContactAt DateTime?
  createdAt     DateTime              @default(now())
  customer      RegularCustomer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  seller        SalesPerson?          @relation(fields: [sellerId], references: [id], onDelete: SetNull)

  @@index([customerId, at])
  @@index([sellerId, at])
}

model CustomerPurchase {
  id              String                 @id @default(cuid())
  customerId      String
  sellerId        String?
  date            DateTime               @db.Date
  amount          Decimal                @db.Decimal(18, 2)
  currency        MoneyCurrency
  amountUzs       Decimal?               @db.Decimal(20, 2)
  amountUsd       Decimal                @db.Decimal(18, 2)
  note            String?
  // Customer location at the time of the purchase, so a later move does not rewrite history.
  country         String?                @db.VarChar(8)
  regionCode      String?                @db.VarChar(16)
  status          CustomerPurchaseStatus @default(PENDING)
  rejectReason    String?
  createdByUserId String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  customer        RegularCustomer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  seller          SalesPerson?           @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  createdBy       AdminUser?             @relation("PurchaseCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  reviewedBy      AdminUser?             @relation("PurchaseReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([customerId, date])
  @@index([sellerId, status])
}

model RegularCustomerMonthlySale {
  id               String          @id @default(cuid())
  customerId       String
  year             Int
  month            Int
  amount           Decimal         @db.Decimal(18, 2)
  currency         MoneyCurrency
  amountUsd        Decimal         @db.Decimal(18, 2)
  note             String?
  createdByAdminId String
  updatedByAdminId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  customer         RegularCustomer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy        AdminUser       @relation("CustomerSaleCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  updatedBy        AdminUser?      @relation("CustomerSaleUpdater", fields: [updatedByAdminId], references: [id], onDelete: SetNull)

  @@unique([customerId, year, month])
  @@index([year, month])
}

model RankingPrize {
  id        String   @id @default(cuid())
  year      Int
  place     Int
  prizeText String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, place])
}

// ---- Sales plan (Sotuv rejasi): separate from SalesAgent ------------------------------------------
enum SalesPersonKind {
  EMPLOYEE
  BRANCH
}

model SalesPerson {
  id             String             @id @default(cuid())
  name           String
  kind           SalesPersonKind    @default(EMPLOYEE)
  branchHead     String?
  note           String?
  isActive       Boolean            @default(true)
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  plans          SalesPlan[]
  monthly        SalesMonthly[]
  // Private Telegram chat for the daily "Bugun qo'ng'iroq" reminder; null = no reminder.
  telegramChatId String?            @db.VarChar(32)
  // Telegram agent (leads, marja) of the same person, for the seller's own dashboard; null = not linked.
  agentId        String?            @unique
  agent          SalesAgent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user           AdminUser?
  customers      RegularCustomer[]
  contacts       CustomerContact[]
  purchases      CustomerPurchase[]

  @@index([isActive, sortOrder])
}

model SalesPeriod {
  id         String      @id @default(cuid())
  name       String
  startYear  Int
  startMonth Int
  monthCount Int         @default(6)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  plans      SalesPlan[]

  @@unique([startYear, startMonth])
}

model SalesPlan {
  id        String      @id @default(cuid())
  periodId  String
  personId  String
  planUsd   Decimal     @db.Decimal(18, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  period    SalesPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  person    SalesPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([periodId, personId])
  @@index([personId])
}

model SalesMonthly {
  id        String      @id @default(cuid())
  personId  String
  year      Int
  month     Int
  amountUsd Decimal     @db.Decimal(18, 2)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  person    SalesPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, year, month])
  @@index([year, month])
}

// ---- Prays: price-list prices, workshop parts and their change history ------------------------------
enum PriceChangeSource {
  MANUAL
  EXCEL
  AI_IMAGE
  PERCENT
}

enum PriceEntityType {
  PRODUCT
  SEX_PART
}

model SexPart {
  id            String    @id @default(cuid())
  name          String
  // "F22", "3/8", "20 L"…
  size          String?
  // Glazok, Klapan, Shlang, Filtr, Resiver, Kompressor, Kondensator…
  group         String
  basePriceUsd  Decimal?  @db.Decimal(18, 2)
  unit          String    @default("dona")
  active        Boolean   @default(true)
  priceListDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workshopItems WorkshopOrderItem[]

  @@index([active, group])
}

model PriceChange {
  id            String            @id @default(cuid())
  entityType    PriceEntityType
  entityId      String
  entityName    String
  oldBase       Decimal?          @db.Decimal(18, 2)
  newBase       Decimal?          @db.Decimal(18, 2)
  source        PriceChangeSource
  priceListName String?
  // Changes confirmed together (one import / one percent change) share a batch.
  batchId       String?
  userId        String?
  createdAt     DateTime          @default(now())
  user          AdminUser?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([batchId])
}

// ---- Sex zakazlari: zborka (AGREGAT) and spare-part (ZAPCHAST) orders to the workshop -----------------
enum WorkshopOrderType {
  AGREGAT
  ZAPCHAST
}

enum WorkshopOrderPurpose {
  // "Magazinga (vitrina)"
  SHOP
  // "Mijozga"
  CLIENT
}

enum WorkshopOrderStatus {
  NEW
  // "Navbatda": accepted, waiting in the queue (ordered by acceptedAt).
  ACCEPTED
  // "Terilmoqda": the workshop started assembling it.
  STARTED
  ISSUED
  RECEIVED
  // "Bekor qilingan": kept in the list (soft), never deleted.
  CANCELLED
}

enum WorkshopItemKind {
  PRODUCT
  PART
}

model WorkshopOrder {
  id                String               @id @default(cuid())
  // Global id for audit; the shown number is "MM-NN" from monthKey / monthNo (01 again every month).
  number            Int                  @unique @default(autoincrement())
  monthKey          String               @db.VarChar(7)
  monthNo           Int
  // Old "MM-NN" when an unfinished order moved into the next month.
  carriedFrom       String?              @db.VarChar(8)
  type              WorkshopOrderType
  purpose           WorkshopOrderPurpose
  customerName      String?
  customerId        String?
  qty               Int                  @default(1)
  dueDate           DateTime?            @db.Date
  note              String?
  sellerId          String
  createdById       String
  // "Zayavkasiz chiqim": written by the workshop after handing goods out; the seller confirms it.
  noRequest         Boolean              @default(false)
  sellerConfirmedAt DateTime?
  status            WorkshopOrderStatus  @default(NEW)
  acceptedById      String?
  acceptedAt        DateTime?
  startedById       String?
  startedAt         DateTime?
  issuedById        String?
  issuedAt          DateTime?
  receivedById      String?
  receivedAt        DateTime?
  cancelledById     String?
  cancelledAt       DateTime?
  cancelReason      String?              @db.VarChar(300)
  // "Test deb belgilash" (SUPER_ADMIN): kept in the list, left out of statistics, the Excel export and queue numbers.
  isTest            Boolean              @default(false)
  // One-time id from the order form: the same submit never creates two orders.
  requestId         String?              @unique @db.VarChar(64)
  // Prices at order time (base, markup, sale); later price-list changes never touch it.
  priceSnapshot     Json?
  // Seh group report ("✅ Sehdan chiqdi"), sent once the order is ISSUED.
  telegramChatId    String?              @db.VarChar(32)
  telegramMessageId Int?
  // Last Telegram delivery failure (personal messages or group report); cleared after a successful resend.
  telegramFailedAt  DateTime?
  telegramError     String?              @db.VarChar(200)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  customer          RegularCustomer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  seller            AdminUser            @relation("WorkshopOrderSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  createdBy         AdminUser            @relation("WorkshopOrderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  acceptedBy        AdminUser?           @relation("WorkshopOrderAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  startedBy         AdminUser?           @relation("WorkshopOrderStarter", fields: [startedById], references: [id], onDelete: SetNull)
  issuedBy          AdminUser?           @relation("WorkshopOrderIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  receivedBy        AdminUser?           @relation("WorkshopOrderReceiver", fields: [receivedById], references: [id], onDelete: SetNull)
  cancelledBy       AdminUser?           @relation("WorkshopOrderCanceller", fields: [cancelledById], references: [id], onDelete: SetNull)
  items             WorkshopOrderItem[]
  messages          WorkshopOrderMessage[]
  corrections       WorkshopCorrectionRequest[]

  @@unique([monthKey, monthNo])
  @@index([status, createdAt])
  @@index([sellerId, createdAt])
  @@index([createdAt])
  @@index([startedAt])
}

enum WorkshopCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
}

// "Tuzatish so'rash": a closed-month order only SUPER_ADMIN edits; others ask with a reason.
model WorkshopCorrectionRequest {
  id           String                   @id @default(cuid())
  orderId      String
  requesterId  String
  reason       String                   @db.VarChar(500)
  status       WorkshopCorrectionStatus @default(PENDING)
  rejectReason String?                  @db.VarChar(300)
  createdAt    DateTime                 @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  order        WorkshopOrder            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requester    AdminUser                @relation("WorkshopCorrectionRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  resolvedBy   AdminUser?               @relation("WorkshopCorrectionResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([orderId])
}

model WorkshopOrderItem {
  id                  String           @id @default(cuid())
  orderId             String
  kind                WorkshopItemKind
  productId           String?
  partId              String?
  title               String
  // Chosen receiver L, water condenser HP, FN block and their standards.
  options             Json?
  qty                 Int
  // Corrected by the workshop on "Chiqib ketdi"; null = as requested.
  issuedQty           Int?
  // Price-list (base) price per unit at order time.
  baseUsd             Decimal?         @db.Decimal(18, 2)
  changedFromStandard Boolean          @default(false)
  order               Int              @default(0)
  workshopOrder       WorkshopOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  part                SexPart?         @relation(fields: [partId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@index([partId])
}

// Personal bot message about an order, one per linked WORKSHOP user; edited on every status change.
model WorkshopOrderMessage {
  id        String        @id @default(cuid())
  orderId   String
  chatId    String        @db.VarChar(32)
  messageId Int
  createdAt DateTime      @default(now())
  order     WorkshopOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, chatId])
}

// ---- Instagram: comment → Direct price (Private Reply) -----------------------------------------------
enum InstagramReplyStatus {
  // Waiting in the queue (new, or a retry after a rate limit / temporary error).
  PENDING
  SENT
  FAILED
  SKIPPED
  // NEGATIVE comment: no reply, sent to the Super Admins on Telegram.
  NOTIFIED
}

// What a comment is about (keywords first, AI when unclear); UNKNOWN gets no reply.
enum InstagramCommentKind {
  PRICE
  POSITIVE
  QUESTION
  NEGATIVE
  SPAM
  UNKNOWN
  // Contact questions (accounts with contactRepliesEnabled): phone, address, working hours.
  PHONE
  ADDRESS
  HOURS
}

// Connected professional accounts (the first one, from before multi-account, has id "global"). The token is AES-256-GCM
// (lib/auth/password-vault.ts).
model InstagramAccount {
  id                  String    @id @default(cuid())
  // Instagram professional account id (= "user_id" of GET /me, = entry.id in webhooks).
  igUserId            String    @unique @db.VarChar(64)
  // Admin name ("Eshik Master"); empty = @username.
  label               String?
  // Who the AI writes as ("BUYUK KARAVAN (sanoat sovutish uskunalari, Namangan)"); empty = @username.
  brandName           String?
  // {manzil} {moljal} {xarita} {ishVaqti} in templates.
  address             String?
  landmark            String?
  mapLink             String?
  workHours           String?
  // PHONE / ADDRESS / HOURS comment kinds: Direct with these templates + the question public reply.
  contactRepliesEnabled Boolean @default(false)
  phoneDmTemplate     String    @default("Assalomu alaykum! Telefon: {telefon}")
  addressDmTemplate   String    @default("Assalomu alaykum! Manzil: {manzil}. Mo'ljal: {moljal}. Xarita: {xarita}")
  hoursDmTemplate     String    @default("Assalomu alaykum! Ish vaqtimiz: {ishVaqti}. Telefon: {telefon}")
  // Price comment on a post without a product and without its own price text: this DM (empty = old behaviour).
  noPriceDmTemplate   String?
  // Telegram groups: Direct cards (empty = admins with "Instagram so‘rovlarini oladi"); negative comments (in addition
  // to the Super Admins).
  directChatId        String?   @db.VarChar(32)
  negativeChatId      String?   @db.VarChar(32)
  // AI reply to every comment that is not spam / negative / a contact or price question (1–2 sentences); prompt: own
  // text (empty = built-in). Leads and Direct → Telegram can be switched off per account.
  aiReplyAll          Boolean   @default(false)
  aiPrompt            String?
  leadsEnabled        Boolean   @default(true)
  directEnabled       Boolean   @default(true)
  username            String
  tokenEncrypted      String
  tokenExpiresAt      DateTime
  tokenRefreshedAt    DateTime
  webhookSubscribedAt DateTime?
  webhookError        String?
  lastWebhookAt       DateTime?
  connectedById       String?
  // Price comment on a post without a product: public reply "Direct'ga yozing…".
  generalReplyEnabled Boolean   @default(false)
  generalReplyText    String    @default("Direct'ga yozing, mutaxassis javob beradi")
  // {telefon} in DM templates; empty = the phone from the site footer.
  phone               String?
  // Which comment kinds are answered (NEGATIVE: Telegram notice to the Super Admins only, never a reply).
  priceEnabled        Boolean   @default(true)
  positiveEnabled     Boolean   @default(false)
  questionEnabled     Boolean   @default(false)
  negativeNotify      Boolean   @default(true)
  // Public replies per Tashkent day (all kinds together).
  dailyReplyLimit     Int       @default(150)
  questionReplyText   String    @default("Batafsil ma'lumotni Direct'ga yubordik 📩")
  questionDmTemplate  String    @default("Assalomu alaykum! Savolingiz bo'yicha mutaxassisimiz yordam beradi: {telefon}")
  // Pacing: the next reply may go out at this time (20–90 s random gap); one queue runner at a time.
  nextActionAt        DateTime?
  runnerUntil         DateTime?
  // Direct → Telegram: working hours (minutes after midnight, Tashkent), optional one-time auto message.
  directWorkStart     Int       @default(540)
  directWorkEnd       Int       @default(1200)
  directAutoAckEnabled Boolean  @default(false)
  directAutoAckText   String    @default("Assalomu alaykum! Xabaringiz qabul qilindi, mutaxassisimiz tez orada javob beradi.")
  // Tashkent dates (YYYY-MM-DD) of the last 09:00 digest / 20:00 report, and the last tick (throttle).
  directDigestDate    String?   @db.VarChar(10)
  directReportDate    String?   @db.VarChar(10)
  directTickAt        DateTime?
  // Permissions granted at the last Instagram Login (statistics need instagram_business_manage_insights).
  grantedScopes       String[]  @default([])
  insightsFetchedAt   DateTime?
  insightsError       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

// A Reels / post with its product and reply settings.
model InstagramMediaRule {
  mediaId            String    @id @db.VarChar(64)
  accountId          String    @default("global") @db.VarChar(64)
  // Price text for a post without a product ("2 500 000 so‘mdan"); sent as the PRICE DM ({telefon} etc. allowed).
  priceText          String?
  productId          String?
  product            Product?  @relation("InstagramRuleProduct", fields: [productId], references: [id], onDelete: SetNull)
  // Optional second product for {mahsulot2} {narx_som2} {havola2}; without it those lines are dropped from the DM.
  secondProductId    String?
  secondProduct      Product?  @relation("InstagramRuleSecondProduct", fields: [secondProductId], references: [id], onDelete: SetNull)
  isActive           Boolean   @default(true)
  keywords           String[]  @default([])
  dmTemplate         String
  publicReplyEnabled Boolean   @default(true)
  publicReplyText    String    @default("Narxini Direct'ga yubordik ✅")
  // Variants for the PRICE public reply, one is picked at random; empty = publicReplyText.
  publicReplyVariants String[]  @default([])
  permalink          String?
  caption            String?
  postedAt           DateTime?
  updatedById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([productId])
  @@index([secondProductId])
  @@index([accountId])
}

// Every comment on our media (the journal); commentId is the idempotency key: one comment → at most one Private Reply.
model InstagramComment {
  commentId        String               @id @db.VarChar(64)
  accountId        String               @default("global") @db.VarChar(64)
  mediaId          String               @db.VarChar(64)
  fromId           String               @db.VarChar(64)
  username         String?
  text             String
  status           InstagramReplyStatus @default(PENDING)
  reason           String?
  productId        String?
  productName      String?
  dmMessageId      String?
  dmSentAt         DateTime?
  publicReplyId    String?
  publicReplyError String?
  leadId           String?
  attempts         Int                  @default(0)
  nextAttemptAt    DateTime             @default(now())
  lockedUntil      DateTime?
  // Reply to another comment (parent_id): never answered.
  parentId         String?              @db.VarChar(64)
  kind             InstagramCommentKind?
  // "KEYWORD" | "AI" | "KEYWORD_FALLBACK"
  classifiedBy     String?              @db.VarChar(20)
  aiTokens         Int                  @default(0)
  aiCostUsd        Decimal?             @db.Decimal(12, 6)
  // What actually went out.
  dmText           String?
  publicReplyText  String?
  publicReplyAt    DateTime?
  notifiedAt       DateTime?
  reviewedAt       DateTime?
  reviewedBy       String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([accountId, status, nextAttemptAt])
  @@index([status, nextAttemptAt])
  @@index([mediaId, createdAt])
  @@index([createdAt])
  @@index([mediaId, fromId])
  @@index([publicReplyAt])
  @@index([kind, createdAt])
}

// Direct messages: incoming (IN) and our own (OUT, from the is_echo webhook). Madina never answers in Direct.
model InstagramMessage {
  mid            String                     @id @db.VarChar(255)
  accountId      String                     @default("global") @db.VarChar(64)
  fromId         String                     @db.VarChar(64)
  text           String?
  hasAttachments Boolean                    @default(false)
  sentAt         DateTime
  conversationId String?
  conversation   InstagramConversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  direction      InstagramMessageDirection  @default(IN)
  toId           String?                    @db.VarChar(64)
  // TEXT, IMAGE, AUDIO, VIDEO, FILE, SHARE, STORY, STICKER, OTHER
  kind           String                     @default("TEXT") @db.VarChar(20)
  // Our automatic messages (comment Private Reply, Direct auto message): do not count as "Javob berildi".
  isAuto         Boolean                    @default(false)
  // On the OUT message that answered: time since the customer started waiting.
  responseMs     Int?
  createdAt      DateTime                   @default(now())

  @@index([createdAt])
  @@index([fromId])
  @@index([conversationId, sentAt])
  @@index([direction, sentAt])
  @@index([accountId, direction, sentAt])
}

enum InstagramMessageDirection {
  IN
  OUT
}

// Qaralmagan → Ochildi (an admin pressed "Instagram’da ochish" in Telegram) → Javob berildi (our echo arrived);
// "Kerak emas" by hand. A new customer message after Javob berildi / Kerak emas starts a new cycle (Qaralmagan).
enum InstagramConversationStatus {
  UNREAD
  OPENED
  ANSWERED
  DISMISSED
}

model InstagramConversation {
  id             String                      @id @default(cuid())
  accountId      String                      @default("global") @db.VarChar(64)
  // Instagram-scoped id of the customer (per account).
  igsid          String                      @db.VarChar(64)
  username       String?
  name           String?
  profileFetchedAt DateTime?
  status         InstagramConversationStatus @default(UNREAD)
  firstMessageAt DateTime
  lastIncomingAt DateTime?
  lastOutgoingAt DateTime?
  // Start of the current unanswered stretch (null when answered / dismissed).
  waitingSince   DateTime?
  messageCount   Int                         @default(0)
  cycleCount     Int                         @default(0)
  openedAt       DateTime?
  openedById     String?
  openedByName   String?
  answeredAt     DateTime?
  // "INSTAGRAM": a person answered in the Instagram app / inbox.
  answeredVia    String?                     @db.VarChar(20)
  lastResponseMs Int?
  dismissedAt    DateTime?
  dismissReason  String?
  dismissedBy    String?
  // Came outside working hours: no card yet, listed in the 09:00 digest.
  deferred       Boolean                     @default(false)
  reminded30At   DateTime?
  reminded2hAt   DateTime?
  // Telegram cards of the current cycle: [{ chatId, messageId, adminId }], edited in place.
  telegramCards  Json                        @default("[]")
  cardLockUntil  DateTime?
  autoAckAt      DateTime?
  leadId         String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  messages       InstagramMessage[]

  @@unique([accountId, igsid])
  @@index([igsid])
  @@index([status, waitingSince])
  @@index([lastIncomingAt])
}

// ---- Instagram statistics (Insights API, daily cron + "Hozir yangilash") -------------------------------
// Account totals for one Tashkent day (Meta may revise the last 2 days, so they are fetched again).
model InstagramDailyStat {
  accountId         String   @default("global") @db.VarChar(64)
  date              String   @db.VarChar(10)
  followersCount    Int?
  reach             Int?
  views             Int?
  accountsEngaged   Int?
  totalInteractions Int?
  likes             Int?
  comments          Int?
  shares            Int?
  saves             Int?
  replies           Int?
  reposts           Int?
  follows           Int?
  unfollows         Int?
  // profile_links_taps by contact_button_type
  linkTaps          Int?
  callTaps          Int?
  directionTaps     Int?
  emailTaps         Int?
  textTaps          Int?
  fetchedAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@id([accountId, date])
}

// One post / Reels / story with its lifetime insights (posts of the last 90 days are refreshed daily).
model InstagramMediaStat {
  mediaId           String   @id @db.VarChar(64)
  accountId         String   @default("global") @db.VarChar(64)
  // REELS | POST | STORY
  type              String   @db.VarChar(10)
  mediaType         String?  @db.VarChar(20)
  postedAt          DateTime
  caption           String?
  permalink         String?
  thumbnail         String?
  views             Int?
  reach             Int?
  likes             Int?
  comments          Int?
  saved             Int?
  shares            Int?
  totalInteractions Int?
  profileVisits     Int?
  follows           Int?
  // profile_activity action_type BIO_LINK_CLICKED (website), CALL, DIRECTION
  websiteClicks     Int?
  callClicks        Int?
  directionClicks   Int?
  // Reels: ig_reels_avg_watch_time (milliseconds)
  avgWatchMs        Int?
  fetchedAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([postedAt])
  @@index([accountId, postedAt])
}

// Follower / engaged audience by country, city, age, gender: one snapshot per day, with Meta's timeframe.
model InstagramAudienceSnapshot {
  accountId String   @default("global") @db.VarChar(64)
  date      String   @db.VarChar(10)
  timeframe String   @db.VarChar(20)
  // { country: { UZ: 1234, … }, city: {…}, age: {…}, gender: {…} }
  follower  Json     @default("{}")
  engaged   Json     @default("{}")
  fetchedAt DateTime @default(now())

  @@id([accountId, date])
}

// Meta "Data Deletion Request" (signed_request) and its status page /data-deletion?code=… The Instagram user id is
// kept only as a SHA-256 hash; the counts say what was removed (comments, messages) or anonymised (leads).
model InstagramDataDeletion {
  code          String    @id @db.VarChar(32)
  userHash      String    @db.VarChar(64)
  // "PENDING" | "COMPLETED"
  status        String    @default("PENDING") @db.VarChar(20)
  comments      Int       @default(0)
  messages      Int       @default(0)
  conversations Int       @default(0)
  leads         Int       @default(0)
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?

  @@index([userHash])
}

// ---- Instagram stories queue: API upload → Super Admin approves (Telegram / admin) → cron publishes -----------------
enum StoryQueueStatus {
  PENDING_APPROVAL
  APPROVED
  PUBLISHING
  PUBLISHED
  REJECTED
  FAILED
  // Not approved by 18:00 Tashkent of its day (or by its time, if later).
  EXPIRED
}

model StoryQueueItem {
  id               String           @id @default(cuid())
  accountId        String           @default("global") @db.VarChar(64)
  // Public URL in the site storage (Instagram fetches video_url itself).
  videoUrl         String
  videoKey         String?          @db.VarChar(200)
  // Internal note (never published).
  caption          String?          @db.VarChar(1000)
  scheduledAt      DateTime
  status           StoryQueueStatus @default(PENDING_APPROVAL)
  sizeBytes        Int?
  durationMs       Int?
  width            Int?
  height           Int?
  // Publishing: the media container, publish attempts (3 = 1 + 2 retries), one cron at a time.
  igContainerId    String?          @db.VarChar(64)
  igMediaId        String?          @db.VarChar(64)
  attempts         Int              @default(0)
  lockedUntil      DateTime?
  error            String?          @db.VarChar(500)
  approvedAt       DateTime?
  approvedBy       String?          @db.VarChar(120)
  publishedAt      DateTime?
  // Telegram approval messages: [{ chatId, messageId, kind: "video" | "text" }]
  telegramMessages Json             @default("[]")
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status, scheduledAt])
  @@index([scheduledAt])
}

// Ovoz studiyasi (TTS): every generation — full files (history), "Sinab eshitish" previews and gallery samples — with
// its characters and estimated cost (the monthly limit sums these). Deleting from the history removes the file and
// sets deletedAt; the row stays for the cost totals.
model TtsGeneration {
  id         String    @id @default(cuid())
  accountId  String    @default("global") @db.VarChar(64)
  // "FULL" | "PREVIEW" | "SAMPLE"
  kind       String    @default("FULL") @db.VarChar(10)
  // "admin" | "api"
  source     String    @db.VarChar(10)
  provider   String    @db.VarChar(30)
  model      String?   @db.VarChar(80)
  voice      String    @db.VarChar(120)
  voiceName  String?   @db.VarChar(120)
  lang       String    @db.VarChar(10)
  speed      Float     @default(1)
  format     String    @db.VarChar(8)
  text       String
  chars      Int
  chunks     Int       @default(1)
  costUsd    Float     @default(0)
  // VoiceLab credits: the provider's own number when it returned one (creditsExact), else ≈ characters × 0.5.
  credits      Int?
  creditsExact Boolean   @default(false)
  durationMs Int?
  sizeBytes  Int?
  audioUrl   String?
  audioKey   String?   @db.VarChar(200)
  createdBy  String?   @db.VarChar(120)
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([createdAt])
  @@index([kind, createdAt])
}

// "Tijorat taklifi" (KP) a seller makes for a client: Prays price + markup, priced on the server when saved.
model CommercialOffer {
  id            String           @id @default(cuid())
  // Shown as KP-0001.
  number        Int              @unique @default(autoincrement())
  sellerId      String
  customerId    String?
  customerName  String           @db.VarChar(120)
  customerPhone String?          @db.VarChar(40)
  markupPercent Decimal          @db.Decimal(6, 2)
  // [{ productId, title, qty, baseUsd, markupPercent, priceUsd }] — baseUsd and markup never reach the PDF.
  items         Json
  totalUsd      Decimal          @db.Decimal(18, 2)
  validUntil    DateTime         @db.Date
  createdAt     DateTime         @default(now())
  seller        AdminUser        @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  customer      RegularCustomer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([sellerId, createdAt])
}
