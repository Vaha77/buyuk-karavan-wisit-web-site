DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
NEON_STORAGE_BUCKET=
OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Workshop ("BK Zborka sehi") group for Seh zakazlari; get the id with /chatid in that group.
TELEGRAM_WORKSHOP_CHAT_ID=
# Users page 👁: 32-byte key, base64 (openssl rand -base64 32). Without it viewing passwords is disabled.
PASSWORD_VIEW_KEY=
# Full production URL, for example: https://example.vercel.app/api/telegram/webhook
TELEGRAM_WEBHOOK_URL=
TELEGRAM_LOCAL_WEBHOOK_URL=http://localhost:3000/api/telegram/webhook
FOLLOWUPS_LOCAL_URL=http://localhost:3000/api/telegram/followups
BACKUP_CRON_SECRET=
BACKUP_CRON_URL=http://localhost:3000/api/cron/crm-backup
TRUST_PROXY=0
# Instagram comment → Direct price (docs/instagram-setup.md). App ID / secret: Meta app → Instagram → API setup with Instagram login.
# The token is stored encrypted with PASSWORD_VIEW_KEY. The verify token is any random string, also typed into the Meta webhook form.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
# Optional: model for classifying Instagram comments / positive replies (default gpt-4.1-mini; uses OPENAI_API_KEY).
OPENAI_INSTAGRAM_MODEL=

# Ovoz studiyasi (TTS) — /admin/instagram/voice and the API
# Bearer token for POST /api/tts and GET /api/tts/voices (no token → API closed).
TTS_API_TOKEN=
# VoiceLab (voicelab.uz, Aisha's new platform) — Uzbek / Russian / English; key starts with vlk_ (tts:read, tts:write, voices:read).
VOICELAB_API_KEY=
# Optional: USD per 1000 characters (1 credit = 1 character; default 0.08 ≈ 1 UZS / character).
VOICELAB_USD_PER_1K_CHARS=
# Legacy (hidden in the studio): old back.aisha.group API. Optional own voices: "Ism:123,Boshqa:456".
AISHA_API_KEY=
AISHA_VOICE_IDS=
# Optional: ElevenLabs (model default eleven_multilingual_v2; eleven_v3 adds Uzbek).
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=
# Optional: OpenAI TTS model (default gpt-4o-mini-tts; uses OPENAI_API_KEY).
OPENAI_TTS_MODEL=
# Limits: monthly estimated USD (default 20, "off" = none), monthly characters (default none), daily request warning (default 50).
TTS_MONTHLY_USD_LIMIT=
TTS_MONTHLY_CHAR_LIMIT=
TTS_DAILY_WARN_REQUESTS=
# Optional cost rates, USD per 1000 characters (defaults: Aisha 0.08 ≈ 1 UZS/char, ElevenLabs 0.2, OpenAI by model).
AISHA_USD_PER_1K_CHARS=
ELEVENLABS_USD_PER_1K_CHARS=
OPENAI_TTS_USD_PER_1K_CHARS=

# BK Kassa Telegram bot (separate from Madina): token, the only Telegram user id it answers, webhook secret.
KASSA_BOT_TOKEN=
KASSA_BOT_OWNER_TG_ID=
KASSA_BOT_WEBHOOK_SECRET=
